{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sewerage-system",
  "version": "0.1.0",
  "identifier": "com.williamss.sewerage-system",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "plugins",
        "title": "Plugins",
        "width": 800,
        "height": 600,
        "decorations": false,
        "url": "index.html",
        "visible": true
      },
    {
        "label": "settings",
        "title": "Settings",
        "width": 800,
        "height": 600,
        "decorations": false,
        "visible": false
    }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
