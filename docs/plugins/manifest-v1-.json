{
    "name": "Excel Exporter",
    "description": "SANCAD to Excel. XLSV and CSV support",
    "version": "1.0.0",
    "author": ["William"],
    "repository": "",
    "download_url": "",
    "icon": "assets/icon.png",
    "id": "com.william.excel-exporter",
    "tags": ["exporter", "importer", "Excel"],
    "exports": [
      {
        "id": "change_pv_names",
        "label": "Change PV names",
        "description": "Changes all PV names to only numbers",
        "entrypoint": "change_pv_names",
        "require_network_data": true,
        "update_network_data": true
      },
        {
            "id": "export_csv_detalhado",
            "label": "Exportar Relatório (CSV)",
            "description": "Gera um CSV completo com filtros avançados",
            "entrypoint": "run_detailed_export",
            "require_network_data": true,
            "parameters": [
                {
                    "name": "separator",
                    "param_type": "select",
                    "label": "Separador",
                    "options": [",", ";", "\t"],
                    "default": ";"
                },
                {
                    "name": "include_headers",
                    "param_type": "boolean",
                    "label": "Incluir cabeçalho?",
                    "default": true
                }
            ]
        },
        {
            "id": "export_xlsv_detalhado",
            "label": "Exportar Relatório (XLSV)",
            "description": "Gera um XLSV completo com filtros avançados",
            "entrypoint": "run_export_csv",
            "require_network_data": true,
            "parameters": [
                {
                    "name": "sheet_name",
                    "param_type": "string",
                    "label": "Nome da Planilha",
                    "default": "Relatorio"
                }
            ]
        }
    ]
}
